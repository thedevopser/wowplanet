APP_NAME=WowPlanet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://wowplanet.dev.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Host-side coordinates: local artisan, Pest and PHPStan reach PostgreSQL through
# the port compose publishes on the loopback. The app and worker containers get
# DB_HOST=postgres / DB_PORT=5432 from compose.yml, which overrides these.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=wowplanet
DB_USERNAME=wowplanet
DB_PASSWORD=wowplanet

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Same split as DB_*: loopback here, redis:6379 injected into the containers.
# The development instance is bound to 127.0.0.1 and runs without a password.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379
# One database index per usage: cache:clear issues FLUSHDB on the cache index,
# which must not take the queue or the sessions with it.
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
# Index dédié : le budget Blizzard ne doit pas être effacé par un cache:clear.
REDIS_BUDGET_DB=4

BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
BLIZZARD_REDIRECT_URI=https://wowplanet.dev.local/auth/blizzard/callback

ADMIN_BNET_ID=

DISCORD_WEBHOOK_URL_CHANGELOG=
DISCORD_WEBHOOK_URL_DISCUSSION=
